GOOGLE_API_KEY=your-google-key-here
MODEL_NAME=gemini-3.7-flash
ENVIRONMENT=local

# Multi-agent conversation persistence (phase 3).
# Leave empty to use an in-memory checkpointer (no persistence across restarts) --
# good for quickly trying things out without standing up Postgres first.
# Set this (or let docker-compose set it for you) to persist conversations:
# DATABASE_URL=postgresql://agent_user:agent_password@localhost:5432/agent_platform
DATABASE_URL=

# MCP server (phase 4): where the agent process looks for tools.
# Local (no Docker): start the MCP server yourself first --
#   python -m mcp_server.server
# then leave this as the default (localhost). In Docker, docker-compose.yml
# overrides this to http://mcp-server:8001/mcp automatically.
# If this URL is unreachable, the app falls back to local in-process tools
# instead of crashing -- check the logs for "falling back to local tools".
MCP_SERVER_URL=http://localhost:8001/mcp

# AI Security / Gateway (phase 5)
# Fallback model: used when the primary Gemini model fails.
# Leave blank to disable fallback (app will return an error if primary fails).
GROQ_API_KEY=
FALLBACK_MODEL_NAME=llama-3.3-70b-versatile

# Guardrails: set to false to disable (useful for development/testing)
GUARDRAILS_ENABLED=true
RATE_LIMIT_PER_MINUTE=30

# LangSmith observability (phase 6)
# Get your API key at https://smith.langchain.com
# Leave blank to run without tracing (works fine, just no LangSmith UI).
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=agent-platform

# AWS Deployment (phase 7)
# Configure via: aws configure  OR set these directly
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=
# AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY are picked up automatically
# from ~/.aws/credentials or environment -- do not put them in this file.
